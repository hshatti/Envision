      <Modes ActiveMode=""/>
    </RunParams>
    <HistoryLists>
      <List Name="LaunchingApplication" Type="File" Count="1">
        <Item1 Value="C:\WINDOWS\system32\cmd.exe /C ${TargetCmdLine}"/>
      </List>
    </HistoryLists>
  </ProjectSession>
  <Debugging>
    <Watches>
      <Item>
        <Expression Value="HP"/>
      </Item>
      <Item>
        <Expression Value="C"/>
      </Item>
      <Item>
        <Expression Value="X"/>
      </Item>
    </Watches>
  </Debugging>
</CONFIG>
